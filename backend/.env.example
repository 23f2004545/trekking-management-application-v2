# =============================================================================
# APEX EXPEDITIONS — BACKEND ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# Flask & Security Secrets
SECRET_KEY=generate_a_random_32_character_hex_string_here
JWT_SECRET_KEY=generate_another_random_32_character_hex_string_here
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Connection (Neon / Supabase / Render PostgreSQL / Local SQLite)
# Format: postgresql+psycopg2://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://username:password@ep-cool-frost-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Message Broker & Cache (Upstash Redis / Render Redis / Local Redis)
# Format: rediss://default:password@hostname:port (rediss:// for SSL/TLS)
REDIS_URL=rediss://default:your_upstash_password@clean-cougar-12345.upstash.io:6379
CELERY_TASK_ALWAYS_EAGER=False

# Cross-Origin Resource Sharing (Frontend URL)
FRONTEND_URL=https://apex-expeditions.vercel.app
CORS_ORIGINS=https://apex-expeditions.vercel.app,http://localhost:5173

# Cloudinary Cloud Asset Storage (Optional - falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloud Email SMTP (Brevo / Sendinblue / Resend / Gmail)
# For Brevo: Host=smtp-relay.brevo.com, Port=587, User=your_brevo_account_email, Password=your_brevo_master_smtp_key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login_email@domain.com
SMTP_PASSWORD=xsmtpib-your_brevo_smtp_api_key
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_SENDER_EMAIL=operations@apex-expeditions.com
